# Neon project in AWS ap-southeast-1 (Singapore). Use the `dev` branch locally, never `main`.
# Pooled connection string (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string, used by Prisma migrations and the seed.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Neon Object Storage (receipts), from the branch's storage credentials. Neon prints these as
# AWS_ENDPOINT_URL_S3 / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION; copy them under the
# S3_* names below, because Vercel reserves the AWS_* names. Leave empty until the bucket exists;
# saving with a receipt then fails with a clear message.
S3_ENDPOINT="https://br-xxx.storage.c-x.ap-southeast-1.aws.neon.tech"
S3_REGION="ap-southeast-1"
S3_BUCKET="uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
